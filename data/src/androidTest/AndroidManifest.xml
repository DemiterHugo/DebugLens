<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <provider
            android:name="io.github.demiterhugo.debuglens.data.repository.LogcatTestProvider"
            android:authorities="${applicationId}.logcat-test"
            android:exported="false" />
        <provider
            android:name="io.github.demiterhugo.debuglens.data.repository.ReportTestProvider"
            android:authorities="${applicationId}.report-test"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
